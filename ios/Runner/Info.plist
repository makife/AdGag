	<string>AdGag uses the microphone to record sound with your Ads.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AdGag saves a video to your photo library when you choose "Save Video" while sharing.</string>
